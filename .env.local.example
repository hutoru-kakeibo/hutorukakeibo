# このファイルはテンプレートです。実際の値は .env.local に書いてください（.env.local はコミットされません）。

# ---- Supabase（公開してよい値） ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# アプリの公開URL。Stripe 決済後の戻り先に使う
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 秘密情報（絶対に公開・コミットしないこと） ----

# Supabase の service_role キー。Stripe Webhook が RLS を迂回して plan を更新するために使う
# 取得場所: Supabase → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe のシークレットキー
# 取得場所: Stripe → 開発者 → APIキー → シークレットキー
STRIPE_SECRET_KEY=sk_test_...

# プレミアムプラン（月額170円）の料金ID
# 取得場所: Stripe → 商品カタログ → 該当商品 → 料金欄の price_ から始まるID
STRIPE_PRICE_ID=price_...

# Webhook の署名シークレット
# ローカル: stripe listen コマンドの出力に表示される whsec_...
# 本番: Stripe → 開発者 → Webhook → 該当エンドポイント → 署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_...
